#!/usr/bin/env bash
# claudepro: Claude Code through a CLIProxyAPI server. install.sh copies this
# file to ~/.local/bin/claudepro.
#
# The server URL is in ~/.config/claudepro/url and the API key in
# ~/.config/claudepro/key. CLAUDEPRO_BASE_URL and CLAUDEPRO_AUTH_TOKEN override
# them, and CLAUDEPRO_MODEL picks a model for one run. The server can pin a
# model with a claudepro-default.<model> alias; otherwise none is pinned.
set -u

for arg in "$@"; do
    case $arg in
        --permission-mode | --permission-mode=*)
            echo 'claudepro: permission mode is fixed to bypassPermissions' >&2
            exit 2
            ;;
    esac
done

dir="$HOME/.local/share/claudepro"
config="$HOME/.config/claudepro"

if [ -z "${CLAUDEPRO_BASE_URL:-}" ]; then
    CLAUDEPRO_BASE_URL=$(cat "$config/url" 2>/dev/null) || {
        echo "claudepro: cannot read $config/url; run the installer again" >&2
        exit 1
    }
fi
if [ -z "${CLAUDEPRO_AUTH_TOKEN:-}" ]; then
    CLAUDEPRO_AUTH_TOKEN=$(cat "$config/key" 2>/dev/null) || {
        echo "claudepro: cannot read $config/key; run the installer again" >&2
        exit 1
    }
fi
export CLAUDEPRO_BASE_URL CLAUDEPRO_AUTH_TOKEN

generated=$(python3 "$dir/claudepro-settings") || exit $?
model=$(printf '%s' "$generated" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("model", ""))') || exit 1

# One file per pinned model (settings-default.json when none), kept after exit:
# background jobs read it again later.
name=${model:-default}
settings_file="$dir/settings-${name//[^A-Za-z0-9._-]/_}.json"
printf '%s\n' "$generated" > "$settings_file.tmp" && mv "$settings_file.tmp" "$settings_file" || exit 1

export ANTHROPIC_BASE_URL="$CLAUDEPRO_BASE_URL"
export ANTHROPIC_AUTH_TOKEN="$CLAUDEPRO_AUTH_TOKEN"
unset ANTHROPIC_API_KEY
# No model is pinned unless CLAUDEPRO_MODEL or the server's alias names one:
# Claude Code then starts on its own default or the /model choice saved in
# ~/.claude/settings.json, and subagents pick their own. Values left over from a
# claudepro session this one was started from are cleared too.
unset CLAUDE_CODE_SUBAGENT_MODEL
if [ -n "$model" ]; then
    export ANTHROPIC_MODEL="$model"
else
    unset ANTHROPIC_MODEL
fi

exec claude --dangerously-skip-permissions --settings "$settings_file" --plugin-dir "$dir/quota-mod" --plugin-dir "$dir/image-mod" "$@"
